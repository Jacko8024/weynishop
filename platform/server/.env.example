# =============================================================================
# WeyniShop server — environment variables
# Copy this file to .env and fill in your real values.
# =============================================================================

# --- PostgreSQL (Sequelize) ----------------------------------------------------
# Any PostgreSQL 14+ works. For local dev you can run one with Docker:
#   docker run -d --name weyni-pg -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=weynishop -p 5432:5432 postgres:16
DATABASE_URL=postgres://postgres:postgres@localhost:5432/weynishop
# false for local Postgres and Coolify-managed Postgres (private network).
# Set true only for cloud providers that require SSL.
DB_SSL=false

# --- File storage (local disk) ---------------------------------------------------
# Directory where uploaded images/documents are written. In production
# (Coolify) this is a persistent volume mounted at /app/uploads.
UPLOADS_DIR=./uploads
# Public base URL of this API (no trailing slash) — used to build absolute
# URLs for uploaded files. Production: https://api.yourdomain.com
PUBLIC_API_URL=http://localhost:5000
# Folder names under UPLOADS_DIR
UPLOAD_FOLDER_PRODUCTS=product-images
UPLOAD_FOLDER_BANNERS=banner-images
UPLOAD_FOLDER_DOCS=onboarding-docs

# --- App ---------------------------------------------------------------------
PORT=5000
JWT_SECRET=change-me-to-something-long-and-random
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
STOREFRONT_URL=http://localhost:5173
GOOGLE_MAPS_API_KEY=

# --- Surprise page owner (ONE merchant account) ------------------------------
# The single seller account that manages the Surprise page (services + booking
# forms) with the same account it uses to sell on the main Weyni shop.
# Set EITHER the numeric user id OR the login email (email is looked up at
# runtime). Leave both empty to keep it admin-only.
SURPRISE_OWNER_ID=
SURPRISE_OWNER_EMAIL=

# --- Firebase Admin (for Google sign-in token verification) ------------------
FIREBASE_PROJECT_ID=weynishop
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@weynishop.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
