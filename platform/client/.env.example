VITE_API_URL=http://localhost:5000
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key
# Public storefront URL opened by the admin "Go to Website" button.
# In dev this is the same as the dev server; in prod set to your live domain.
VITE_STOREFRONT_URL=http://localhost:5173

# ---- Firebase web config (optional; defaults are baked into src/lib/firebase.js) ----
# Override these only if you point the client at a different Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ============================================================================
# GOOGLE MAPS API KEY — SECURITY SETUP (Cloud Console → APIs & Services →
# Credentials → your key → "EDIT API RESTRICTIONS" / "APPLICATION
# RESTRICTIONS"). The Maps key is PUBLIC by design (it ships in the JS
# bundle) — restrictions are what stop abuse & billing surprises:
#
# 1) API RESTRICTIONS → "Restrict key" → enable ONLY:
#      - Maps JavaScript API            (map rendering, Geocoder)
#      - Places API (New)               (address autocomplete, place details)
#    Do NOT enable Geocoding API / Directions etc. unless you use them.
#
# 2) APPLICATION RESTRICTIONS → "Websites" (HTTP referrers), add ALL of:
#      https://www.weynishop.com/*
#      https://weynishop.com/*
#      http://localhost:5173/*          (dev server)
#      https://localhost/*              (Capacitor Android WebView origin)
#    The Capacitor WebView loads the bundle from https://localhost, so that
#    referrer MUST be allow-listed or maps/places break inside the APK.
#
# 3) Billing alerts: Cloud Console → Billing → Budgets & alerts.
# ============================================================================
